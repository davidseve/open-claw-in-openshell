# OpenClaw-in-OpenShell Secrets
# Copy this file to secrets/secrets.env and fill in the values.
# DO NOT commit secrets.env to git.

MAAS_API_KEY=<YOUR_MAAS_API_KEY_HERE>

# Phase 12 (RHOAI-managed MLflow, see ADR-0017): backend Postgres password
# used by both charts/rhoai/database and charts/rhoai/mlflow. Auto-generated
# and appended here by scripts/deploy-rhoai-mlflow.sh on first run if unset —
# you normally don't need to fill this in by hand.
MLFLOW_DB_PASSWORD=
