# OpenClaw-in-OpenShell Secrets
# Copy this file to secrets/secrets.env and fill in the values.
# DO NOT commit secrets.env to git.

MAAS_API_KEY=<YOUR_MAAS_API_KEY_HERE>

# RHOAI-managed MLflow (see docs/adrs/ADR-0018-rhoai-mlflow-sole-backend.md):
# backend Postgres password used by both charts/rhoai/database and
# charts/rhoai/mlflow. Auto-generated and appended here by
# scripts/deploy-rhoai-mlflow.sh on first run if unset — you normally don't
# need to fill this in by hand. RHOAI MLflow is now the only tracing backend
# (the standalone ghcr.io/mlflow/mlflow deployment was removed) — this
# variable is required for every deploy, not just an opt-in experiment.
MLFLOW_DB_PASSWORD=

# The two secrets below are also auto-generated and appended here on first
# run (by scripts/deploy-keycloak.sh and scripts/deploy-oauth2-proxy.sh,
# respectively) via common.sh's ensure_secret_var() helper — same pattern as
# MLFLOW_DB_PASSWORD above. You normally don't need to fill these in by hand.
KC_BROKER_SECRET=
OAUTH_PROXY_SESSION_SECRET=
